PORT=4000
JWT_SECRET=troque-por-uma-chave-secreta-forte

# Em produção, coloque a URL do seu frontend publicado (ex: https://c2s-clone.vercel.app)
# Deixe vazio/"*" em desenvolvimento.
CORS_ORIGIN=*

# Caminho do arquivo do banco SQLite. Só mexa se for usar um disco persistente
# em produção (ex: no Render: /var/data/c2s.sqlite)
DB_PATH=

# WhatsApp (Meta Cloud API) - preencha quando tiver a conta comercial
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=escolha-uma-frase-secreta

# Facebook/Instagram Lead Ads - preencha ao configurar o webhook no Meta for Developers
FB_VERIFY_TOKEN=escolha-outra-frase-secreta
